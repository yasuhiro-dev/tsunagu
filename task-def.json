{
    "containerDefinitions": [
        {
            "name": "tsunagu-backend",
            "image": "363852138137.dkr.ecr.ap-northeast-1.amazonaws.com/tsunagu-backend:latest",
            "cpu": 0,
            "memory": 1024,
            "memoryReservation": 1024,
            "portMappings": [
                {
                    "containerPort": 3000,
                    "hostPort": 3000,
                    "protocol": "tcp",
                    "name": "tsunagu-backend-3000-tcp",
                    "appProtocol": "http"
                }
            ],
            "essential": true,
            "environment": [
                {
                    "name": "RAILS_LOG_TO_STDOUT",
                    "value": "true"
                },
                {
                    "name": "RAILS_ENV",
                    "value": "production"
                },
                {
                    "name": "DATABASE_NAME",
                    "value": "tsunagu_production"
                },
                {
                    "name": "DATABASE_HOST",
                    "value": "tsunagu-db.cdy6qoyymj9u.ap-northeast-1.rds.amazonaws.com"
                },
                {
                    "name": "DATABASE_USERNAME",
                    "value": "tsunagu_admin"
                },
                {
                    "name": "RAILS_SERVE_STATIC_FILES",
                    "value": "true"
                },
                {
                    "name": "BACKEND_URL",
                    "value": "https://api.tsunagu-app.com"
                },
                {
                    "name": "FRONTEND_URL",
                    "value": "https://tsunagu-app.com"
                },
                {
                    "name": "SOLID_QUEUE_IN_PUMA",
                    "value": "true"
                }
            ],
            "environmentFiles": [],
            "mountPoints": [],
            "volumesFrom": [],
            "secrets": [
                {
                    "name": "DATABASE_PASSWORD",
                    "valueFrom": "arn:aws:secretsmanager:ap-northeast-1:363852138137:secret:tsunagu/production/rails-AnEuMR:DATABASE_PASSWORD::"
                },
                {
                    "name": "RAILS_MASTER_KEY",
                    "valueFrom": "arn:aws:secretsmanager:ap-northeast-1:363852138137:secret:tsunagu/production/rails-AnEuMR:RAILS_MASTER_KEY::"
                },
                {
                    "name": "SECRET_KEY_BASE",
                    "valueFrom": "arn:aws:secretsmanager:ap-northeast-1:363852138137:secret:tsunagu/production/rails-AnEuMR:SECRET_KEY_BASE::"
                }
            ],
            "ulimits": [],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/tsunagu-backend-task",
                    "awslogs-create-group": "true",
                    "awslogs-region": "ap-northeast-1",
                    "awslogs-stream-prefix": "ecs"
                },
                "secretOptions": []
            },
            "systemControls": []
        }
    ],
    "family": "tsunagu-backend-task",
    "taskRoleArn": "arn:aws:iam::363852138137:role/tsunagu-ecs-exec-role",
    "executionRoleArn": "arn:aws:iam::363852138137:role/ecsTaskExecutionRole",
    "networkMode": "awsvpc",
    "volumes": [],
    "placementConstraints": [],
    "runtimePlatform": {
        "cpuArchitecture": "X86_64",
        "operatingSystemFamily": "LINUX"
    },
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "256",
    "memory": "1024"
}